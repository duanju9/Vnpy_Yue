# 使用说明：复制本文件为同目录下的 .env，填写 56 位 TSY_TOKEN（勿提交 .env）
#   copy .env.example .env
# 手册: http://tsy.xiaodefa.cn/docs

TSY_TOKEN=

# miniQMT：userdata_mini 绝对路径（可选，供 examples/miniqmt_try.py 使用）
# MINIQMT_USERDATA=

# chan_web / quantdb（可选；勿提交含密码的 .env）
# CHAN_WEB_PG_URI=postgresql://quantuser:密码@127.0.0.1:5433/quantdb
# 或分项（端口本机常为 5433）:
# PGHOST=127.0.0.1
# PGPORT=5433
# PGDATABASE=quantdb
# PGUSER=quantuser
# PGPASSWORD=
# 关闭自动入库（默认会自动同步索引与 K 线缓存）:
# CHAN_WEB_DISABLE_AUTO_SYNC_INDEX=1
# CHAN_WEB_DISABLE_PG_OHLCACHE=1
# 关闭 chan_web 侧边栏「叠 chan 笔/中枢」（不跑 CChan）:
# CHAN_WEB_DISABLE_CHAN_OVERLAY=1
# chan 叠加调试：强制 CChan 走 xtdata 拉线（默认用当前页 DataFrame 注入、不重复拉取）:
# CHAN_WEB_CHAN_OVERLAY_USE_QMT_REFETCH=1
